{
  "name": "meanwhile-cli",
  "version": "0.2.0",
  "description": "Open any site while your coding agent works, then get pulled back when it needs you. Hooks for Claude Code, Codex, and Conductor.",
  "license": "MIT",
  "author": "ZepaMK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ztsrdev/meanwhile.git"
  },
  "homepage": "https://github.com/ztsrdev/meanwhile#readme",
  "bugs": "https://github.com/ztsrdev/meanwhile/issues",
  "keywords": [
    "claude-code",
    "codex",
    "conductor",
    "ai-agents",
    "productivity",
    "duolingo",
    "macos",
    "hooks"
  ],
  "type": "module",
  "bin": {
    "meanwhile": "dist/meanwhile.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/bundle.mjs",
    "bundle": "node scripts/bundle.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
